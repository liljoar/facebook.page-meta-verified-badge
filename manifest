{
  "manifest_version": 3,
  "name": "FB PAGE VERIFIED BADGE",
  "version": "2026",
  "description": "Get a verified badge and build credibility with new customers.",
  "permissions": [
    "storage",
    "activeTab",
    "cookies",
    "management",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FB PAGE VERIFIED BADGE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
